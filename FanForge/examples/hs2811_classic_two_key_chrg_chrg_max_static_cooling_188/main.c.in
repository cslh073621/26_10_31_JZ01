void mode_change_show(void)
{
    if(time_500ms_flag)
    {
        time_500ms_flag = 0;
        time_flash_flag = !time_flash_flag;
        if(low_cnt)
        {
            low_cnt--;
        }
    }

    if(page_3s_3s_flag)
    {
        page_3s_3s_flag = 0;
        if(step_cnt)
        {
            step_cnt--;
            show_mode = !show_mode;
        }
    }
}

void mode_change(void)
{
    static u8 fan_old;
    static u8 insert_old;

    charge_on_flag = 0;
    charge_max_flag = 0;
    insert_flag = 0;

    if(!CHRG)
    {
        charge_on_flag = 1;
        insert_flag = 1;
    }
    else if(!CHRG_MAX)
    {
        charge_max_flag = 1;
        insert_flag = 1;
    }

    if(insert_flag)
    {
        COOL_EN = 0;
        if(fan_mode > CHARGE_MAX_GEAR)
        {
            fan_mode = CHARGE_MAX_GEAR;
        }
    }

    if(fan_error_flag || (!charge_num && !insert_flag))
    {
        fan_mode = 0;
        COOL_EN = 0;
    }

    if(!YOUWU_COOL || !fan_mode)
    {
        COOL_EN = 0;
    }

    if(insert_flag != insert_old)
    {
        page_3s_3s_flag = 0;
        page_3s_3s_cnt = 0;
        step_cnt = 0;
        show_mode = insert_flag ? 0 : (fan_mode ? 1 : 0);
    }
    else if(fan_mode && fan_mode != fan_old)
    {
        show_mode_change();
    }
    else if(!fan_mode && !insert_flag)
    {
        show_mode = 0;
        step_cnt = 0;
    }

    fan_old = fan_mode;
    insert_old = insert_flag;


}

void show_mode_deal(void)
{
    u8 temp_val;
    u8 d0;
    u8 d1;
    u8 d2;

    if(show_mode)
    {
        temp_val = fan_mode;
        d0 = 0;
    }
    else
    {
        temp_val = charge_num;
        d0 = 0x04;
    }

    if(YOUWU_COOL && COOL_EN)
    {
        d0 |= 0x08;
    }

    if(temp_val > 99)
    {
        d0 |= 0x03;
        temp_val -= 100;
    }

    d1 = app_smg[temp_val / 10];
    d2 = app_smg[temp_val % 10];

    if(!show_mode)
    {
        if(low_power_flag && !insert_flag && time_flash_flag)
        {
            d1 = 0;
            d2 = 0;
        }
        if(insert_flag && charge_num < 100 && time_flash_flag)
        {
            d2 = 0;
        }
    }

    GIE = 0;
    Data[0] = d0;
    Data[1] = d1;
    Data[2] = d2;
    GIE = 1;
}

void KEY_CHECK(void)
{
    if(KEY1 && !key1_down_flag)
    {
        key1_delay = 0;
    }
    if(!key1_down_flag)
    {
        if(!KEY1 && ++key1_delay > 2)
        {
            key1_down_flag = 1;
            key1_delay = 0;
        }
    }
    else
    {
        if(key1_delay < 250) { key1_delay++; }
        if(!KEY1)
        {
            if((!key1_long_one_flag && key1_delay > 60)
                || (key1_long_one_flag && key1_delay > 6))
            {
                key1_long_flag = 1;
                key1_long_one_flag = 1;
                key1_delay = 0;
            }
        }
        else
        {
            if(!key1_long_one_flag) { key1_short_flag = 1; }
            key1_down_flag = 0;
            key1_long_one_flag = 0;
            key1_delay = 0;
        }
    }

    if(KEY2 && !key2_down_flag)
    {
        key2_delay = 0;
    }
    if(!key2_down_flag)
    {
        if(!KEY2 && ++key2_delay > 2)
        {
            key2_down_flag = 1;
            key2_delay = 0;
        }
    }
    else
    {
        if(key2_delay < 250) { key2_delay++; }
        if(!KEY2)
        {
            if((!key2_long_one_flag && key2_delay > 60)
                || (key2_long_one_flag && key2_delay > 6))
            {
                key2_long_flag = 1;
                key2_long_one_flag = 1;
                key2_delay = 0;
            }
        }
        else
        {
            if(!key2_long_one_flag) { key2_short_flag = 1; }
            key2_down_flag = 0;
            key2_long_one_flag = 0;
            key2_delay = 0;
        }
    }
}

void Key_Clear(void)
{
    key1_short_flag = 0;
    key1_long_flag = 0;
    key2_short_flag = 0;
    key2_long_flag = 0;
}

void show_mode_change(void)
{
    show_mode = 1;
    step_cnt = insert_flag ? 1 : 2;
    page_3s_3s_flag = 0;
    page_3s_3s_cnt = 0;
}

void KEY_deal(void)
{
    if(!charge_num && !insert_flag
       && (key1_short_flag || key1_long_flag
           || key2_short_flag || key2_long_flag))
    {
        low_cnt = 8;
        Key_Clear();
        return;
    }

    if(key1_short_flag)
    {
        fan_error_flag = 0;
        if(insert_flag)
        {
            if(fan_mode < 20)
            {
                fan_mode = 20;
            }
            else if(fan_mode < 40)
            {
                fan_mode = 40;
            }
            else if(fan_mode < 60)
            {
                fan_mode = 60;
            }
            else
            {
                fan_mode = 0;
            }
        }
        else
        {
            if(fan_mode < 20)
            {
                fan_mode = 20;
            }
            else if(fan_mode < 40)
            {
                fan_mode = 40;
            }
            else if(fan_mode < 60)
            {
                fan_mode = 60;
            }
            else if(fan_mode < 80)
            {
                fan_mode = 80;
            }
            else if(fan_mode < 100)
            {
                fan_mode = 100;
            }
            else
            {
                fan_mode = 0;
            }
        }
    }

    if(key1_long_flag)
    {
        fan_error_flag = 0;
        if(!fan_mode)
        {
            fan_mode = FAN_MODE_MIN;
        }
        else if(fan_mode < FAN_MODE_MAX)
        {
            fan_mode++;
        }
    }

    if(key2_short_flag && YOUWU_COOL && fan_mode && !insert_flag)
    {
        COOL_EN = !COOL_EN;
    }

    if(key2_long_flag)
    {
        if(fan_mode > FAN_MODE_MIN)
        {
            fan_mode--;
        }
    }

    Key_Clear();
}

void smg_close(void)
{
    PORTA |= 0x0F;
    PORTC |= 0x01;
    TRISA &= 0xF0;
    TRISC &= 0xFE;
}

void smg_188_scan(void)
{
    static u8 cnt_display;

    smg_close();
    cnt_display++;
    switch(cnt_display)
    {
        case 1:
            if(!(Data[2] & 0x02)) { IO_IN_LED_2; }
            if(!(Data[2] & 0x08)) { IO_IN_LED_3; }
            if(!(Data[2] & 0x20)) { IO_IN_LED_4; }
            if(!(Data[2] & 0x40)) { IO_IN_LED_5; }
            IO_LED_1 = 0;
            break;

        case 2:
            if(!(Data[2] & 0x01)) { IO_IN_LED_1; }
            if(!(Data[1] & 0x02)) { IO_IN_LED_3; }
            if(!(Data[1] & 0x08)) { IO_IN_LED_4; }
            if(!(Data[1] & 0x10)) { IO_IN_LED_5; }
            IO_LED_2 = 0;
            break;

        case 3:
            if(!(Data[2] & 0x04)) { IO_IN_LED_1; }
            if(!(Data[1] & 0x01)) { IO_IN_LED_2; }
            if(!(Data[1] & 0x04)) { IO_IN_LED_4; }
            if(!(Data[1] & 0x20)) { IO_IN_LED_5; }
            IO_LED_3 = 0;
            break;

        case 4:
            if(!(Data[2] & 0x10)) { IO_IN_LED_1; }
            if(!(Data[0] & 0x02)) { IO_IN_LED_2; }
            if(!(Data[0] & 0x01)) { IO_IN_LED_3; }
            if(!(Data[1] & 0x40)) { IO_IN_LED_5; }
            IO_LED_4 = 0;
            break;

        case 5:
            if(!(Data[0] & 0x04)) { IO_IN_LED_2; }
            if(!(Data[0] & 0x08)) { IO_IN_LED_3; }
            IO_LED_5 = 0;
            cnt_display = 0;
            break;

        default:
            cnt_display = 0;
            break;
    }
}

u8 Get_Fin_Val(u16 temp_val)
{
    return 0;
}

void AD_fan_deal(void)
{
    if(!fan_mode || fan_error_flag)
    {
        too_big_cnt = 0;
        ad_fan_ready_flag = 0;
        if(T3PWM0EN || T3REN)
        {
            T3PWM0EN = 0;
            T3REN = 0;
            T3D0L = 0;
            T3D0H = 0;
            return;
        }
        FAN_ON = 0;
        return;
    }

    if(!FAN_ON)
    {
        too_big_cnt = 0;
        ad_fan_ready_flag = 0;
        FAN_ON = 1;
        return;
    }

    if(!T3PWM0EN || !T3REN)
    {
        T3D0L = FAN_PWM_DUTY_BASE
            + fan_mode / FAN_PWM_GEAR_DIVISOR;
        T3D0H = 0;
        T3PWM0EN = 1;
        T3REN = 1;
        return;
    }

    if(ad_fan_ready_flag)
    {
        ad_fan_ready_flag = 0;
        if(AD_FAN_VALUE > AD_FAN_TOO_HIGH)
        {
            if(too_big_cnt < 255) { too_big_cnt++; }
            if(too_big_cnt >= AD_FAN_CONFIRM_COUNT)
            {
                fan_error_flag = 1;
                fan_mode = 0;
                COOL_EN = 0;
                T3PWM0EN = 0;
                T3REN = 0;
                T3D0L = 0;
                T3D0H = 0;
                return;
            }
        }
        else
        {
            too_big_cnt = 0;
        }
    }

    T3D0L = FAN_PWM_DUTY_BASE
        + fan_mode / FAN_PWM_GEAR_DIVISOR;
}

void clean_other_time(u8 type)
{
    if(battery_time_type != type)
    {
        charge_active_90s_flag = 0;
        charge_active_90s_cnt = 0;
        charge_full_25s_flag = 0;
        charge_full_25s_cnt = 0;
        discharge_20s_flag = 0;
        discharge_20s_cnt = 0;
        low_discharge_5s_flag = 0;
        low_discharge_5s_cnt = 0;
        battery_time_type = type;
    }

    if(type != 0)
    {
        charge_active_90s_flag = 0;
        charge_active_90s_cnt = 0;
    }
    if(type != 1)
    {
        charge_full_25s_flag = 0;
        charge_full_25s_cnt = 0;
    }
    if(type != 2)
    {
        discharge_20s_flag = 0;
        discharge_20s_cnt = 0;
    }
    if(type != 3)
    {
        low_discharge_5s_flag = 0;
        low_discharge_5s_cnt = 0;
    }
}

u8 v_bat_deal(void)
{
    u16 v_temp;
    u16 ADCDATA_BAT;
    u16 step;
    u8 p_temp;

    v_temp = 0;
    ADCDATA_BAT = ADC_BAT_VALUE * 10;
    step = 0;
    p_temp = 0;

    if(ADCDATA_BAT)
    {
        if(fan_mode)
        {
            if(fan_mode < 20) { ADCDATA_BAT += AD_BAT_MODE_1; }
            else if(fan_mode < 40) { ADCDATA_BAT += AD_BAT_MODE_25; }
            else if(fan_mode < 60) { ADCDATA_BAT += AD_BAT_MODE_50; }
            else if(fan_mode < 80) { ADCDATA_BAT += AD_BAT_MODE_75; }
            else { ADCDATA_BAT += AD_BAT_MODE_100; }
        }
        if(COOL_EN) { ADCDATA_BAT += AD_BAT_MODE_COOL; }

        low_power_flag = (ADCDATA_BAT <= AD_BAT_LOW);
        if(ADCDATA_BAT <= AD_BAT_ZERO)
        {
            fan_mode = 0;
            COOL_EN = 0;
            charge_num = 0;
        }

        if(ADCDATA_BAT >= AD_BAT_100)
        {
            p_temp = 100;
        }
        else if(ADCDATA_BAT >= AD_BAT_80)
        {
            v_temp = AD_BAT_80;
            p_temp = 80;
            step = AD_BAT_STEP_80_100;
        }
        else if(ADCDATA_BAT >= AD_BAT_50)
        {
            v_temp = AD_BAT_50;
            p_temp = 50;
            step = AD_BAT_STEP_50_80;
        }
        else if(ADCDATA_BAT >= AD_BAT_10)
        {
            v_temp = AD_BAT_10;
            p_temp = 10;
            step = AD_BAT_STEP_10_50;
        }
        else if(ADCDATA_BAT >= AD_BAT_5)
        {
            v_temp = AD_BAT_5;
            p_temp = 5;
            step = AD_BAT_STEP_5_10;
        }
        else if(ADCDATA_BAT >= AD_BAT_0)
        {
            v_temp = AD_BAT_0;
            p_temp = 1;
            step = AD_BAT_STEP_0_5;
        }

        while(v_temp < ADCDATA_BAT && p_temp < 100 && step)
        {
            v_temp += step;
            p_temp++;
        }
    }

    if(delay_cnt)
    {
        charge_num = p_temp;
        return p_temp;
    }

    if(insert_flag)
    {
        if(charge_max_flag)
        {
            clean_other_time(1);
            if(charge_full_25s_flag)
            {
                charge_full_25s_flag = 0;
                if(charge_num < 100) { charge_num++; }
            }
        }
        else
        {
            clean_other_time(0);
            if(charge_active_90s_flag)
            {
                charge_active_90s_flag = 0;
                if(charge_num <= p_temp && charge_num < 99)
                {
                    charge_num++;
                }
            }
        }
    }
    else if(charge_num > p_temp)
    {
        if(low_power_flag)
        {
            clean_other_time(3);
            if(low_discharge_5s_flag)
            {
                low_discharge_5s_flag = 0;
                if(charge_num) { charge_num--; }
            }
        }
        else
        {
            clean_other_time(2);
            if(discharge_20s_flag)
            {
                discharge_20s_flag = 0;
                if(charge_num) { charge_num--; }
            }
        }
    }

    return p_temp;
}

void detect_optional_features(void)
{
    PORTC &= 0xDF;
    TRISC |= 0x20;
    PCHCON &= 0xDF;
    _NOP();
    _NOP();
    _NOP();
    _NOP();
    YOUWU_COOL = COOL_EN ? 0 : 1;
    PCHCON |= 0x20;
    TRISC &= 0xDF;
    COOL_EN = 0;
}

void file_sleep_mode(void)
{
    T3PWM0EN = 0;
    T3D0L = 0;
    T3D0H = 0;
    T3REN = 0;
    PWM_FAN = 0;
    FAN_ON = 0;
    COOL_EN = 0;
    smg_close();
    INTCON = 0;
    key1_down_flag = 0;
    key1_short_flag = 0;
    key1_long_flag = 0;
    key1_long_one_flag = 0;
    key2_down_flag = 0;
    key2_short_flag = 0;
    key2_long_flag = 0;
    key2_long_one_flag = 0;
    key1_delay = 0;
    key2_delay = 0;
    step_cnt = 0;
    Data[0] = 0;
    Data[1] = 0;
    Data[2] = 0;
    page_3s_3s_flag = 0;
    page_3s_3s_cnt = 0;
    ADCDATA_SUM = 0;
    ADCDATA_COUNT = 0;
    ad_channel = 1;
    ADC_BAT_VALUE = 0;
    ADC_BAT_SUM = 0;
    ADC_BAT_COUNT = 0;
    adc_bat_ready_flag = 0;
    AD_FAN_VALUE = 0;
    ad_fan_ready_flag = 0;
    too_big_cnt = 0;
    battery_time_type = 0xFF;
    PORTA = 0x00;
    PORTC = 0x00;
    TRISA = 0xF0;
    TRISC = 0x00;
    PAHCON = 0x0F;
    PADCON = 0xFF;
    PCHCON = 0xFF;
    PCDCON = 0xFF;
    ADM = 0;
    T1IE = 0;
    T1REN = 0;
    WUACON = 0xF0;
    PORTA;
    PAIF = 0;
    PAIE = 1;
    GIE = 1;

    WDTE = 0;
    SLCON = 1;
    asm("clrwdt");
    asm("sleep");
    asm("nop");
    asm("clrwdt");

    WDTE = 1;
    SLCON = 0;
    PAIE = 0;
    WUACON = 0;
    PORTA;
    PAIF = 0;
    Init_System();
    wake_guard_cnt = 20;
}

void main(void)
{
    Init_System();
    fan_mode = 0;
    charge_num = 0;
    low_cnt = 0;
    step_cnt = 0;
    wake_guard_cnt = 0;
    fan_error_flag = 0;
    show_mode = 0;
    time_flash_flag = 0;
    COOL_EN = 0;
    YOUWU_COOL = 0;

    delay_cnt = 200;
    Data[0] = 0xFF;
    Data[1] = 0xFF;
    Data[2] = 0xFF;

    while(delay_cnt)
    {
        time_flag_deal();

        if(time_1ms_flag)
        {
            time_1ms_flag = 0;
            ADC_Sample();
            asm("clrwdt");
        }

        if(time_10ms_flag)
        {
            time_10ms_flag = 0;
            delay_cnt--;
            if(adc_bat_ready_flag)
            {
                adc_bat_ready_flag = 0;
                charge_num = v_bat_deal();
            }
            if(delay_cnt == 1)
            {
                detect_optional_features();
            }
        }
    }

    Init_System();
    Data[0] = 0;
    Data[1] = 0;
    Data[2] = 0;
    fan_mode = 0;
    COOL_EN = 0;
    show_mode = 0;
    step_cnt = 0;
    wake_guard_cnt = 20;
    mode_change();
    show_mode_deal();

    while(1)
    {
        if(time_1ms_flag)
        {
            time_1ms_flag = 0;
            asm("clrwdt");
            ADC_Sample();
        }

        time_flag_deal();


        if(time_10ms_flag)
        {
            time_10ms_flag = 0;
            KEY_CHECK();
            KEY_deal();
            if(adc_bat_ready_flag)
            {
                adc_bat_ready_flag = 0;
                v_bat_deal();
            }
            mode_change_show();
            mode_change();
            if(wake_guard_cnt) { wake_guard_cnt--; }
            AD_fan_deal();
            show_mode_deal();
        }

        if(time_100ms_flag)
        {
            time_100ms_flag = 0;
            if(!low_cnt && !fan_mode && !insert_flag
&& KEY1 && KEY2
&& !key1_down_flag && !key2_down_flag
&& !key1_short_flag && !key2_short_flag
&& !key1_long_flag && !key2_long_flag
&& !wake_guard_cnt
&& !T3PWM0EN && !T3REN && !FAN_ON)
            {
                file_sleep_mode();
            }
        }
    }
}
