u8 ADC_Sample(void)
{
    u16 ad_temp;
    u8 wait_cnt;

    if(!ADCDATA_COUNT)
    {
        if(ad_channel == 1)
        {
            ADM = 0x9C;
            VREFH = 0x00;
            ADR = 0x40;
            ad_channel = 0;
        }
        else if(ad_channel == 0)
        {
            ADM = 0x95;
            VREFH = 0x00;
            ADR = 0x40;
            ad_channel = 1;
        }
    }

    ADM |= 0x40;
    wait_cnt = 50;
    while(!(ADM & 0x20))
    {
        _NOP();
        _NOP();
        _NOP();
        _NOP();
        if(0 == (--wait_cnt))
        {
            return 0;
        }
    }

    ad_temp = ADB;
    ad_temp <<= 4;
    ad_temp |= (ADR & 0x0F);

    ADCDATA_COUNT++;
    if(ADCDATA_COUNT > 2)
    {
        ADCDATA_SUM += ad_temp;
    }
    if(ADCDATA_COUNT >= 10)
    {
        ADCDATA_COUNT = 0;
        ADCDATA_SUM >>= 3;
        if(ad_channel == 0)
        {
            ADC_BAT_COUNT++;
            ADC_BAT_SUM += ADCDATA_SUM;
            if(ADC_BAT_COUNT >= 16)
            {
                ADC_BAT_COUNT = 0;
                ADC_BAT_VALUE = ADC_BAT_SUM >> 4;
                ADC_BAT_SUM = 0;
                adc_bat_ready_flag = 1;
            }
        }
        else if(ad_channel == 1)
        {
            AD_FAN_VALUE = ADCDATA_SUM;
            ad_fan_ready_flag = 1;
        }
        ADCDATA_SUM = 0;
    }

    /* u16 accumulation limits checked by FanForge:
     * 4095 * 8 = 32760 <= 65535.
     * Overvoltage confirmation count: 13.
     */
    return 0;
}

