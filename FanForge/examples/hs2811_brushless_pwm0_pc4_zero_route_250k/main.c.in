#define FAN_PWM_DUTY      55
#define AD_FAN_TOO_HIGH    2978
/* Consecutive valid overvoltage means; normal resets count. Min 2; F824 baseline 13. */
#define AD_FAN_CONFIRM_COUNT  13

bit time_1ms_flag;
bit time_10ms_flag;
