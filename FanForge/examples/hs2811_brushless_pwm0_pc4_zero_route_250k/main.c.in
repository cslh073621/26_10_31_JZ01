void AD_fan_deal(void)
{
    if(fan_mode == 0 || fan_error_flag)
    {
        too_big_cnt = 0;
        if(T3PWM0EN || T3REN)
        {
            T3PWM0EN = 0;
            T3REN = 0;
            T3D0L = 0;
            T3D0H = 0;
            return;
        }

        FAN_ON = 0;
        return;
    }

    if(ad_fan_ready_flag)
    {
        ad_fan_ready_flag = 0;
        if(AD_FAN_VALUE > AD_FAN_TOO_HIGH)
        {
            if(too_big_cnt < 255)
            {
                too_big_cnt++;
            }
            if(too_big_cnt >= AD_FAN_CONFIRM_COUNT)
            {
                fan_error_flag = 1;
                fan_mode = 0;
                T3PWM0EN = 0;
                T3REN = 0;
                T3D0L = 0;
                T3D0H = 0;
                return;
            }
        }
        else
        {
            too_big_cnt = 0;
        }
    }

    if(!FAN_ON)
    {
        FAN_ON = 1;
        return;
    }

    /* AD_fan_deal() runs every 10ms. Reaching this call after
     * FAN_ON was asserted provides the required brushless delay.
     */
    T3D0L = 0x23;
    T3D0H = 0x00;
    T3PWM0EN = 1;
    T3REN = 1;
}

