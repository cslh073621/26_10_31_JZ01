void file_sleep_mode(void)
{
    T3D0L = 0;
    T3D0H = 0;
    T3PWM0EN = 0;
    T3REN = 0;
    PWM_FAN = 0;
    FAN_ON = 0;
    smg_close();
    INTCON = 0;
    ADCDATA_SUM = 0;
    ADCDATA_COUNT = 0;
    AD_FAN_VALUE = 0;
    ad_fan_ready_flag = 0;
    too_big_cnt = 0;
    PORTA = 0x00;
    PORTC = 0x00;
    TRISA = 0x00;
    TRISC = 0x00;
    PAHCON = 0xFF;
    PADCON = 0xFF;
    PCHCON = 0xFF;
    PCDCON = 0xFF;
    ADM = 0;
    T1IE = 0;
    T1REN = 0;
    WUACON = 0x00;
    PORTA;
    PAIF = 0;
    PAIE = 0;
    GIE = 1;

    WDTE = 0;
    SLCON = 1;
    asm("clrwdt");
    asm("sleep");
    asm("nop");
    asm("clrwdt");

    WDTE = 1;
    SLCON = 0;
    PAIE = 0;
    PORTA;
    PAIF = 0;
    Init_System();

}

void main(void)
{
    Init_System();
    fan_mode = 0;
    fan_error_flag = 0;

    delay_cnt = 200;


    while(delay_cnt)
    {
        time_flag_deal();

        if(time_1ms_flag)
        {
            time_1ms_flag = 0;
            ADC_Sample();
            asm("clrwdt");
        }

        if(time_10ms_flag)
        {
            time_10ms_flag = 0;
            delay_cnt--;

        }
    }



    while(1)
    {
        if(time_1ms_flag)
        {
            time_1ms_flag = 0;
            asm("clrwdt");
            ADC_Sample();
        }

        time_flag_deal();


        if(time_10ms_flag)
        {
            time_10ms_flag = 0;

            mode_change_show();
            mode_change();
            AD_fan_deal();
            show_mode_deal();
        }

        if(time_100ms_flag)
        {
            time_100ms_flag = 0;
            if(0)
            {
                file_sleep_mode();
            }
        }
    }
}
