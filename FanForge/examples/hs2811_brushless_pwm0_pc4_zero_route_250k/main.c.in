}

u8 ADC_Sample(void)
{
    u16 ad_temp;
    u8 wait_cnt;

    if(!ADCDATA_COUNT)
    {
        ADM = 0x95;
        VREFH = 0x00;
        ADR = 0x10;
    }

    ADM |= 0x40;
    wait_cnt = 128;
    while(!(ADM & 0x20))
    {
        _NOP();
        _NOP();
        _NOP();
        _NOP();
        if(0 == (--wait_cnt))
        {
            return 0;
        }
    }

    ad_temp = ADB;
    ad_temp <<= 4;
    ad_temp |= (ADR & 0x0F);

    ADCDATA_COUNT++;
    if(ADCDATA_COUNT > 2)
    {
        ADCDATA_SUM += ad_temp;
    }
    if(ADCDATA_COUNT >= 10)
    {
        ADCDATA_COUNT = 0;
        ADCDATA_SUM >>= 3;
        AD_FAN_VALUE = ADCDATA_SUM;
        ad_fan_ready_flag = 1;
        ADCDATA_SUM = 0;
    }

    /* u16 accumulation limits checked by FanForge:
     * 4095 * 8 = 32760 <= 65535.
     * Overvoltage confirmation count: 13.
     */
    return 0;
}

void time_flag_deal(void)
{
    if(time_10ms_cnt > 9)
    {
        time_10ms_cnt = 0;
        time_10ms_flag = 1;
        time_100ms_cnt++;
    }

    if(time_100ms_cnt > 9)
    {
        time_100ms_cnt = 0;
        time_100ms_flag = 1;
    }
}

