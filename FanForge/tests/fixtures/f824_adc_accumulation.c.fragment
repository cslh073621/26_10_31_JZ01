/* F824 ADC accumulation, extracted before channel result dispatch.
 * Source: H:/WorkSpace/HS/26_07_21_F824/project/main.c
 * Source SHA256: b0ab0d0ae4fee4d9119156fcb5e57d772aa8464ccb8d541c741eb8d1322dd189
 */
    ADCDATA_COUNT++;
    if(ADCDATA_COUNT > 4)
    {
        ADCDATA_SUM += ad_temp;
        if((ADCDATA_COUNT & 0x07) == 4)
        {
            ADC_GROUP_SUM += ADCDATA_SUM >> 3;
            ADCDATA_SUM = 0;
        }
    }
    if(ADCDATA_COUNT >= 100)
    {
        ADCDATA_COUNT = 0;
        ADCDATA_SUM = ADC_GROUP_SUM / 12;
        ADC_GROUP_SUM = 0;
    }
