@@OPTIONAL_FUNCTION_IMPLEMENTATIONS@@

void file_sleep_mode(void)
{
    @@OUTPUT_SHUTDOWN_BEFORE_SLEEP@@
    smg_close();
    INTCON = 0;
    @@SLEEP_EVENT_CLEAR@@
    @@SLEEP_GPIO_CONFIGURATION@@
    ADM = 0;
    @@SLEEP_PERIPHERAL_SHUTDOWN@@
    @@WAKE_SOURCE_CONFIGURATION@@

    WDTE = 0;
    SLCON = 1;
    asm("clrwdt");
    asm("sleep");
    asm("nop");
    asm("clrwdt");

    @@WAKE_COMMON_RESTORE@@
    Init_System();
    @@WAKE_STABILITY_GUARD@@
}

void main(void)
{
    Init_System();
    @@POWER_ON_STATE_INITIALIZATION@@

    delay_cnt = @@SELF_TEST_TICK_COUNT@@;
    @@SELF_TEST_OUTPUT_INITIALIZATION@@

    while(delay_cnt)
    {
        time_flag_deal();

        if(@@ADC_SCHEDULER_FLAG@@)
        {
            @@ADC_SCHEDULER_FLAG@@ = 0;
            ADC_Sample();
            asm("clrwdt");
        }

        if(@@MAIN_SCHEDULER_FLAG@@)
        {
            @@MAIN_SCHEDULER_FLAG@@ = 0;
            delay_cnt--;
            @@SELF_TEST_FIXED_TICK_BODY@@
        }
    }

    @@POST_SELF_TEST_RESTORE@@

    while(1)
    {
        if(@@ADC_SCHEDULER_FLAG@@)
        {
            @@ADC_SCHEDULER_FLAG@@ = 0;
            asm("clrwdt");
            ADC_Sample();
        }

        time_flag_deal();
        @@INPUT_EVENT_SCHEDULER@@

        if(@@MAIN_SCHEDULER_FLAG@@)
        {
            @@MAIN_SCHEDULER_FLAG@@ = 0;
            @@INPUT_PROCESSING_CALLS@@
            mode_change_show();
            mode_change();
            @@OUTPUT_PROCESSING_CALLS@@
            show_mode_deal();
        }

        if(@@SLEEP_SCHEDULER_FLAG@@)
        {
            @@SLEEP_SCHEDULER_FLAG@@ = 0;
            if(@@SLEEP_ELIGIBILITY_EXPRESSION@@)
            {
                file_sleep_mode();
            }
        }
    }
}
