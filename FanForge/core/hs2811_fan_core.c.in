void Init_System(void)
{
    OPTION = 0x00;
    OSCM = 0x00;
    INTCON = 0x00;
    WDTE = 1;
    PIE1 = 0x00;
    PIR1 = 0x00;
    PIE2 = 0x00;
    PIR2 = 0x00;

    GPIO_Init();
    ADC_Init();
    timer1_init();
    pwm_init();
    @@SYSTEM_SAFE_CLOSE@@
}

u8 ADC_Sample(void)
{
    u16 ad_temp;
    u8 wait_cnt;

    @@ADC_CHANNEL_SWITCH@@

    ADM |= 0x40;
    wait_cnt = @@ADC_CONVERSION_WAIT_LIMIT@@;
    while(!(ADM & 0x20))
    {
        _NOP();
        _NOP();
        _NOP();
        _NOP();
        if(0 == (--wait_cnt))
        {
            return 0;
        }
    }

    ad_temp = ADB;
    ad_temp <<= 4;
    ad_temp |= (ADR & 0x0F);

    @@ADC_DISCARD_ACCUMULATE_AVERAGE_AND_DISPATCH@@
    return 0;
}

