void interrupt myIsr(void)
{
    if(PAIF)
    {
        PORTA;
        PAIF = 0;
        @@PORT_CHANGE_ISR_BODY@@
    }

    if(T1IF)
    {
        T1IF = 0;
        T1TH = @@T1_RELOAD_HIGH@@;
        T1TL = @@T1_RELOAD_LOW@@;

        @@HIGH_RATE_ISR_BODY@@
        @@BASE_TIME_ISR_PREFIX@@
        @@BASE_TIME_ISR_BODY@@
        @@FIXED_1MS_ISR_BODY@@
        @@BASE_TIME_ISR_SUFFIX@@
    }
}

